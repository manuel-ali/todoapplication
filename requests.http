@baseUrl = http://localhost:8080

# Run "Login" and "1. Create task" first.

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "manuel@test.com", "password": "secret123" }

### 1. Create task
# @name createTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "Testing @Valid annotation",
    "description": "Test request for task 1.1",
    "status": "IN_PROGRESS",
    "priority": "HIGH",
    "dueDate": "2026-12-01T18:00:00"
}

### 2. Create task with empty title
POST {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "",
    "description": "Test request for task 1.1",
    "status": "PENDING",
    "priority": "HIGH",
    "dueDate": "2026-12-01T18:00:00"
}

### 3. Update task without status
PUT {{baseUrl}}/tasks/{{createTask.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "Updating a task without status",
    "description": "Test request for task 1.1",
    "priority": "HIGH",
    "dueDate": "2026-12-01T18:00:00"
}

### 4. Get non-existent task
GET {{baseUrl}}/tasks/9999999
Authorization: Bearer {{login.response.body.token}}

### 5. Get Tasks without Authorization
GET {{baseUrl}}/tasks

### 6. Get Tasks with Bearer abc
GET {{baseUrl}}/tasks
Authorization: Bearer abc

### 7. Get Tasks with a real token with a changed letter
